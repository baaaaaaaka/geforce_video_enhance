{
  "manifest_version": 3,
  "name": "GeForce Video Enhance",
  "short_name": "GF Video",
  "version": "0.1.0",
  "key": "",
  "description": "Adds YouTube controls for RTX Video Super Resolution and Smooth Motion experiments.",
  "minimum_chrome_version": "110",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://www.youtube-nocookie.com/*"
  ],
  "action": {
    "default_title": "YouTube RTX VSR",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.youtube-nocookie.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
